# Образец настроек. Скопируй в .env и подставь свои значения:
#   cp .env.example .env
# Файл .env в git не попадает — он закрыт в .gitignore, а хук pre-commit не даст его закоммитить.

# Токен бота от @BotFather. Выглядит как 123456789:AA... — это пароль от бота,
# никому не отправляй и не вставляй в чаты. Если засветил — сразу /revoke в BotFather.
BOT_TOKEN=

# Адрес, где живёт приложение. Только https, иначе Telegram его не откроет.
APP_URL=https://my-body-upgrade-app.vercel.app

# Подпись на кнопке меню в чате с ботом (необязательно).
BTN_TEXT=Кузница Тела
