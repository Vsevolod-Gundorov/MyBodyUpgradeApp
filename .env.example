# ОБРАЗЕЦ. Этот файл лежит в git и виден всем — значения сюда НЕ вписывать.
#
# Свои значения клади в .env: он закрыт в .gitignore и никуда не уходит.
#   cp .env.example .env
#   nano .env
#
# Если токен всё же попал в любой файл репозитория — считай его засвеченным:
# сначала /revoke в BotFather, потом новый токен в .env.

# Токен бота от @BotFather. Заполняется ТОЛЬКО в .env
BOT_TOKEN=

# Адрес приложения. Только https, иначе Telegram его не откроет.
APP_URL=https://my-body-upgrade-app.vercel.app

# Подпись на кнопке меню в чате с ботом (необязательно).
BTN_TEXT=Кузница Тела
