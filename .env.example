# ОБРАЗЕЦ. Этот файл лежит в git и виден всем — значения сюда НЕ вписывать.
#
# Свои значения клади в .env: он закрыт в .gitignore и никуда не уходит.
#   cp .env.example .env
#   nano .env
#
# Если токен всё же попал в любой файл репозитория — считай его засвеченным:
# сначала /revoke в BotFather, потом новый токен в .env.

# Токен бота от @BotFather. Заполняется ТОЛЬКО в .env (и в переменных Vercel как Sensitive).
# Им же сервер проверяет подпись Telegram — без него сервер журнала не включится.
BOT_TOKEN=

# ---- Сервер журнала (Vercel → Settings → Environment Variables) ----
# Строку подключения Postgres прописывает сам Neon при подключении базы к проекту.
DATABASE_URL=
# Необязательно: отдельный логин приложения — жёсткая граница вокруг RLS (см. SETUP.md, шаг 9).
DATABASE_URL_APP=
# Необязательно. Пусто — регистрация открыта: каждый, кто открыл приложение через бота,
# заводится в базе сам. Задано — закрытая бета: только эти @username или числовые id через запятую.
ALLOWED_USERS=

# Адрес приложения. Только https, иначе Telegram его не откроет.
APP_URL=https://my-body-upgrade-app.vercel.app

# Подпись на кнопке меню в чате с ботом (необязательно).
BTN_TEXT=Кузница Тела
